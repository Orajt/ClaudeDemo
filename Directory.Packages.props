<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Wersje z tego pliku obowiązują też dla zależności przechodnich (Marten, EF Core) – D-012. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Critter Stack – wersje potwierdzone w spike'u (D-012) -->
  <ItemGroup>
    <PackageVersion Include="Marten" Version="9.54.2" />
    <PackageVersion Include="WolverineFx" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.FluentValidation" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.56.0" />
    <PackageVersion Include="JasperFx" Version="2.96.0" />
    <PackageVersion Include="JasperFx.Events" Version="2.96.0" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.96.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
  </ItemGroup>

  <!-- EF Core (DataHub) – D-012 -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
  </ItemGroup>

  <!-- Aspire i uwierzytelnianie – D-014 -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.4-preview.1.26523.11" />
    <PackageVersion Include="Aspire.Keycloak.Authentication" Version="13.6.4-preview.1.26523.11" />
  </ItemGroup>

  <!-- ServiceDefaults (szablon Aspire) – D-014 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <!-- Zależności wygenerowanego klienta API dla GUI – D-014 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Net.Http.Headers" Version="10.0.14" />
  </ItemGroup>

  <!-- Testy -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Alba" Version="8.5.3" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
  </ItemGroup>
</Project>
