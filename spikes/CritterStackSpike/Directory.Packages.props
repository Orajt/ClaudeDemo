<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Wersje z tego pliku obowiązują też dla zależności przechodnich (np. EF Core spod Npgsql). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Critter Stack -->
    <PackageVersion Include="Marten" Version="9.54.2" />
    <PackageVersion Include="WolverineFx" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.56.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.56.0" />
    <PackageVersion Include="JasperFx" Version="2.96.0" />
    <PackageVersion Include="JasperFx.Events" Version="2.96.0" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.96.0" />
    <!-- EF Core (DataHub) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <!-- Testy -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>
</Project>
